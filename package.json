{
  "name": "guess-who",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run client & npm run api",
    "client": "npm run dev --prefix client",
    "api": "node --env-file=.env --import tsx/esm dev-server.ts",
    "build": "cd client && npm install && npm run build",
    "install:all": "npm install && npm install --prefix client"
  },
  "dependencies": {
    "@upstash/redis": "^1.34.3",
    "@vercel/node": "^3.0.0",
    "pusher": "^5.2.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "puppeteer": "^24.40.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0"
  }
}
